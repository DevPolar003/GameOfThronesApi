<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.MainPage"
             Title="Game of Thrones API">

    <ScrollView>
        <VerticalStackLayout 
            Padding="20"
            Spacing="15"
            VerticalOptions="Start">

            <Label 
                Text="Game of Thrones Quotes"
                Style="{StaticResource Headline}"
                SemanticProperties.HeadingLevel="Level1"
                FontSize="28"
                FontAttributes="Bold"
                HorizontalTextAlignment="Center" />

            <Label 
                Text="Busque citações de seus personagens favoritos"
                FontSize="14"
                TextColor="Gray"
                HorizontalTextAlignment="Center" />

            <Frame 
                BorderColor="#E0E0E0"
                CornerRadius="10"
                Padding="15"
                HasShadow="True">
                <VerticalStackLayout Spacing="12">
                    <Label 
                        Text="BUSCAR POR PERSONAGEM"
                        FontSize="14"
                        FontAttributes="Bold"
                        TextColor="#333" />

                    <Label 
                        Text="Nome do Personagem"
                        FontSize="12"
                        TextColor="#666" />
                    <Entry 
                        x:Name="AuthorEntry"
                        Placeholder="Ex: Tyrion, Jon Snow, Daenerys"
                        PlaceholderColor="LightGray"
                        FontSize="14" />

                    <Label 
                        Text="Quantidade de Frases (1-10)"
                        FontSize="12"
                        TextColor="#666" />
                    <Entry 
                        x:Name="CountEntry"
                        Placeholder="Ex: 5"
                        Keyboard="Numeric"
                        PlaceholderColor="LightGray"
                        FontSize="14"
                        Text="5" />

           
                    <HorizontalStackLayout Spacing="10" HorizontalOptions="FillAndExpand">
                        <Button 
                            x:Name="SearchButton"
                            Text="BUSCAR"
                            FontSize="14"
                            FontAttributes="Bold"
                            Padding="10"
                            BackgroundColor="#1f77d4"
                            TextColor="White"
                            CornerRadius="8"
                            HorizontalOptions="FillAndExpand"
                            Clicked="OnSearchClicked" />

                        <Button 
                            x:Name="ClearButton"
                            Text="LIMPAR"
                            FontSize="14"
                            FontAttributes="Bold"
                            Padding="10"
                            BackgroundColor="#d9534f"
                            TextColor="White"
                            CornerRadius="8"
                            HorizontalOptions="FillAndExpand"
                            Clicked="OnClearClicked" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Frame>


            <ActivityIndicator 
                x:Name="LoadingIndicator"
                IsRunning="False"
                IsVisible="False"
                Color="#1f77d4"
                Scale="1.5" />

       
            <Label 
                x:Name="ErrorLabel"
                Text=""
                TextColor="Red"
                FontSize="12"
                IsVisible="False"
                Padding="10"
                BackgroundColor="#FFE0E0" />
            <Frame 
                x:Name="ResultsFrame"
                BorderColor="#E0E0E0"
                CornerRadius="10"
                Padding="15"
                HasShadow="True"
                IsVisible="False">
                <VerticalStackLayout Spacing="12">
                    <Label 
                        Text="RESULTADOS"
                        FontSize="14"
                        FontAttributes="Bold"
                        TextColor="#333" />

                    <CollectionView 
                        x:Name="QuotesCollectionView"
                        SelectionMode="None">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout 
                                Orientation="Vertical" 
                                ItemSpacing="10" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame 
                                    BorderColor="#CCCCCC"
                                    CornerRadius="8"
                                    Padding="12"
                                    Margin="5">
                                    <VerticalStackLayout Spacing="8">
                                        <Label 
                                            Text="{Binding Sentence}"
                                            FontSize="13"
                                            FontAttributes="Italic"
                                            TextColor="#333"
                                            LineBreakMode="WordWrap" />
                                        <Label 
                                            Text="{Binding Author, StringFormat='— {0}'}"
                                            FontSize="12"
                                            TextColor="#666"
                                            HorizontalTextAlignment="End" />
                                    </VerticalStackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Frame>

   
            <Frame 
                BorderColor="#E8F4F8"
                CornerRadius="10"
                Padding="12"
                BackgroundColor="#F0F8FC">
                <VerticalStackLayout Spacing="5">
                    <Label 
                        Text="ℹ️ Informações da API"
                        FontSize="12"
                        FontAttributes="Bold"
                        TextColor="#1f77d4" />
                    <Label 
                        Text="API: Game of Thrones Quotes"
                        FontSize="11"
                        TextColor="#666" />
                    <Label 
                        Text="Base URL: api.gameofthronesquotes.xyz/v1"
                        FontSize="11"
                        TextColor="#666" />
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>

